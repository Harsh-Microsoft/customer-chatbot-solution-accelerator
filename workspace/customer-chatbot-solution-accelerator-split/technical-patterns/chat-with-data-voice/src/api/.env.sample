# Ported from chat-app/backend/env.sample and scenario-app/backend/env.sample
# (plan row 20/36), with COSMOS_DB_DATABASE_NAME's domain default replaced by a
# generic one and SCENARIO_PATH added per the composition contract (6A.1).
SCENARIO_PATH=

# Azure Cosmos DB
COSMOS_DB_ENDPOINT=your_cosmos_db_endpoint
COSMOS_DB_KEY=your_cosmos_db_key
COSMOS_DB_DATABASE_NAME=chat_with_data_voice_db

# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_ENDPOINT=your_openai_endpoint
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_FOUNDRY_ENDPOINT=
AZURE_AI_AGENT_ENDPOINT=
AZURE_AI_AGENT_API_VERSION=2025-05-01
FOUNDRY_CHAT_AGENT=chat-agent
FOUNDRY_PRODUCT_AGENT=catalog-agent
FOUNDRY_POLICY_AGENT=policy-agent

# Azure AI Search (Stable Core-owned; endpoint supplied at compose time)
AZURE_AI_SEARCH_ENDPOINT=

# Microsoft Entra ID
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_TENANT_ID=your_tenant_id

# Application Insights (telemetry disabled if not set)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Logging
AZURE_BASIC_LOGGING_LEVEL=INFO
AZURE_PACKAGE_LOGGING_LEVEL=WARNING
AZURE_LOGGING_PACKAGES=

# Voice Live
AZURE_VOICELIVE_ENDPOINT=
VOICELIVE_MODEL=gpt-realtime-mini
VOICELIVE_VOICE=alloy
VOICELIVE_TRANSCRIBE_MODEL=gpt-4o-transcribe
VOICELIVE_VAD_SILENCE_MS=1200
VOICELIVE_VAD_THRESHOLD=0.5
VOICELIVE_VAD_PREFIX_PADDING_MS=300

